generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  cpf            String   @unique
  nome           String
  passwordHash   String
  role           String
  practitionerId String
  createdAt      DateTime @default(now())
}

model Location {
  id           String      @id @default(uuid())
  physicalType String
  createdAt    DateTime    @default(now())
  encounters   Encounter[]
}

model Encounter {
  id           String        @id @default(uuid())
  locationId   String
  status       String
  date         DateTime      @default(now())

  location     Location      @relation(fields: [locationId], references: [id])
  specimens    Specimen[]
  observations Observation[]
  procedures   Procedure[]
}

/// Achados quantitativos da ação mecânica (ex: depósitos inspecionados/eliminados)
model Observation {
  id            String @id @default(uuid())
  encounterId   String
  code          String // "depositos-inspecionados" | "depositos-eliminados"
  valueQuantity Int    @default(0)

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([encounterId])
}

/// Foco/tubito coletado para envio ao laboratório
model Specimen {
  id                   String  @id @default(uuid())
  encounterId          String
  type                 String  // Classificação do depósito: A1, A2, B, C, D1, D2 ou E
  tubitoId             String? // Código/identificador único do tubito de coleta
  quantidade           Int     @default(1)
  resultadoLaboratorio String? // null = pendente | "positivo" | "negativo"

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([encounterId])
  @@index([resultadoLaboratorio])
}

/// Ação de tratamento químico (larvicida/adulticida)
model Procedure {
  id          String  @id @default(uuid())
  encounterId String
  name        String  // tipo de larvicida/adulticida aplicado
  realizado   Boolean @default(true) // indicador de uso
  quantidade  Float?  // quantidade aplicada em gramas/ml

  encounter Encounter @relation(fields: [encounterId], references: [id])

  @@index([encounterId])
}